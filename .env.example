# Deskzy local development
DESKZY_API_ADDR=:8080
DESKZY_PUBLIC_BASE=http://localhost:8080
DESKZY_CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DESKZY_API_PROXY=http://localhost:8080

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Add these values to enable the widget and server-side verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET=your_turnstile_secret_key
# Production should only include production frontend hostnames, not localhost.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Supabase Auth + Postgres (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Razorpay (https://dashboard.razorpay.com) — test mode keys OK for local
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Create Plans in Razorpay Dashboard → Subscriptions → Plans
# Monthly: ₹399 / month · Yearly: ₹2,699 / year (per seat; quantity at checkout)
RAZORPAY_PLAN_MONTHLY_ID=plan_xxx_monthly
RAZORPAY_PLAN_YEARLY_ID=plan_xxx_yearly
